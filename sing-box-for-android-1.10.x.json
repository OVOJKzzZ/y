{
  "log": {
    "disabled": false,
    "level": "warn",
    "output": "1.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "proxy-dns",
        "address": "https://1.1.1.1/dns-query",
        "detour": "select"
      },
      {
        "tag": "direct-dns",
        "address": "223.5.5.5",
        "detour": "direct-out"
      },
      {
        "tag": "tls-dns",
        "address": "https://223.5.5.5/dns-query",
        "detour": "direct-out"
      }
    ],
    "rules": [
      {
        "outbound": "any",
        "server": "tls-dns"
      },
      {
        "domain": "github.boki.moe",
        "server": "tls-dns"
      },
      {
        "clash_mode": "全局",
        "server": "proxy-dns"
      },
      {
        "clash_mode": "直连",
        "server": "direct-dns"
      },
      {
        "rule_set": [
          "geosite-geolocation-cn",
          "geosite-tld-cn"
        ],
        "server": "direct-dns"
      }
    ],
    "final": "proxy-dns",
    "strategy": "ipv4_only",
    "disable_cache": false,
    "disable_expire": false,
    "independent_cache": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": "172.18.0.1/30",
      "mtu": 1500,
      "auto_route": true,
      "strict_route": true,
      "sniff": true
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        "♻️ 自动选择",
        "🇺🇸 美国 1",
        "🇺🇸 美国 2"
      ],
      "default": "",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "♻️ 自动选择",
      "outbounds": [
        "🇺🇸 美国 1",
        "🇺🇸 美国 2"  
      ],
      "interval": "2m",
      "tolerance": 100,
      "interrupt_exist_connections": true
    },
    {
      "type": "direct",
      "tag": "direct-out"
    },
    {
      "type": "dns",
      "tag": "dns-out"
    },
    {
      "type": "block",
      "tag": "block-out"
    },
    {
      "type": "hysteria2",
      "tag": "🇺🇸 美国 1",
      "server": "dianfeng-us.legeth.xyz",
      "server_port": 47424,
      "password": "ac176117-dced-424e-91ba-55b6fe7b7ef4",
      "tls": {
        "enabled": true,
        "server_name": "",
        "alpn": "h3"
      }
    },
    {
      "type": "vless",
      "tag": "🇺🇸 美国 2",
      "server": "ew.cloudflare.182682.xyz",
      "server_port": 443,
      "uuid": "8b18a941-b3bf-4cf3-957d-5d87b309d923",
      "tls": {
        "enabled": true,
        "server_name": "us.oldcloud.online",
        "utls": {
          "enabled": true,
          "fingerprint": "edge"
        }
      },
      "packet_encoding": "xudp",
      "transport": {
        "type": "ws",
        "path": "/",
        "headers": {
          "Host": "us.oldcloud.online"
        },
        "max_early_data": 0,
        "early_data_header_name": "Sec-WebSocket-Protocol"
      }
    }
  ],
  "route": {
    "rules": [
      {
        "protocol": "dns",
        "outbound": "dns-out"
      },
      {
        "port": 53,
        "outbound": "dns-out"
      },
      {
        "ip_is_private": true,
        "outbound": "direct-out"
      },
      {
        "clash_mode": "全局",
        "outbound": "select"
      },
      {
        "clash_mode": "直连",
        "outbound": "direct-out"
      },
      {
        "port": 853,
        "outbound": "block-out"
      },
      {
        "rule_set": [
          "geosite-geolocation-cn",
          "geosite-tld-cn",
          "geoip-cn"
        ],
        "outbound": "direct-out"
      },
      {
        "protocol": "quic",
        "outbound": "block-out"
      },
      {
        "network": "udp",
        "port": 443,
        "outbound": "block-out"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-geolocation-cn",
        "format": "binary",
        "url": "https://github.boki.moe/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs",
        "download_detour": "direct-out",
        "update_interval": "3d"
      },
      {
        "type": "remote",
        "tag": "geosite-tld-cn",
        "format": "binary",
        "url": "https://github.boki.moe/https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-tld-cn.srs",
        "download_detour": "direct-out",
        "update_interval": "3d"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://github.boki.moe/https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs",
        "download_detour": "direct-out",
        "update_interval": "3d"
      }
    ],
    "final": "",
    "find_process": true,
    "auto_detect_interface": true
  },
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_fakeip": false
